{
  "name": "UpdateSalesEntityRelPeriod",
  "label": "Update Sales Entity Rel Period",
  "description": "Mass-updates SalesEntityRel for the records matching UpdateCondition and runs SetRelationshipPeriodToToday.",
  "timeout": "10000",
  "maxRetries": "0",
  "successStatusCodes": "2xx",
  "httpMethod": "POST",
  "requestUrl": "https://poc-mercedes.eu.semarchy.net/dm/api/rest/loads/CustomerMDM/CONT_SALESENTITYREL",
  "requestHeaders": "API-Key: _gPvTnp.d_7rMz12dRwY5MsyD2Kg83iZazSx7dcBWC8",
  "requestBodyFormat": "JSON",
  "requestBody": "{\"action\":\"MASS_UPDATE_DATA\",
  \"massUpdateOptions\":{\"responsePayload\":\"SUMMARY\",\"persistMode\":\"IF_NO_ERROR_OR_MATCH\",\"optionsPerEntity\":{\"SalesEntityRel\":{
  \"updateCondition\":${UpdateCondition},\"updateValues\":{\"StartDate\":\"2026-01-01\"},\"enrichers\":[\"SetRelationshipPeriodToToday\"],\"validations\":\"JOB_PRE_CONSO\"}}}}",
  "requestInputs": [
    {
      "name": "UpdateCondition",
      "label": "Update Condition",
      "description": "SemQL condition selecting the SalesEntityRel records to update.",
      "dataType": "STRING"
    }
  ],
  "responseOutputs": [
    {
      "name": "status",
      "label": "Status",
      "dataType": "STRING",
      "valueSelector": "$.status",
      "defaultValue": "UNKNOWN",
      "onAbsentValueBehavior": "USE_DEFAULT_VALUE",
      "onDataTypeMismatchBehavior": "USE_DEFAULT_VALUE"
    }
  ]
}