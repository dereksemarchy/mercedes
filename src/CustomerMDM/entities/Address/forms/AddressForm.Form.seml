                _name: GeoHereId
                value: GeocodeResult.HereId
                label: "HERE Id"
                useCustomLabel: true
                dataType: STRING
              - _type: TextField
                _name: GeoResultType
                value: GeocodeResult.ResultType
                label: "Result Type"
                useCustomLabel: true
                dataType: STRING
              - _type: TextField
                _name: GeoHouseNumberType
                value: GeocodeResult.HouseNumberType
                label: "House Number Type"
                useCustomLabel: true
                dataType: STRING
              - _type: TextField
                _name: GeoFormattedAddress
                value: GeocodeResult.FormattedAddress
                label: "Formatted Address"
                useCustomLabel: true
                dataType: STRING
              - _type: TextField
                _name: GeoHouseNumber
                value: GeocodeResult.HouseNumber
                label: "House Number"
                useCustomLabel: true
                dataType: STRING
              - _type: TextField
                _name: GeoStreet
                value: GeocodeResult.Street
                label: "Street"
                useCustomLabel: true
                dataType: STRING
              - _type: TextField
                _name: GeoDistrict
                value: GeocodeResult.District
                label: "District"
                useCustomLabel: true
                dataType: STRING
              - _type: TextField
                _name: GeoCity
                value: GeocodeResult.City
                label: "City"
                useCustomLabel: true
                dataType: STRING
              - _type: TextField
                _name: GeoCounty
                value: GeocodeResult.County
                label: "County"
                useCustomLabel: true
                dataType: STRING
              - _type: TextField
                _name: GeoState
                value: GeocodeResult.State
                label: "State"
                useCustomLabel: true
                dataType: STRING
              - _type: TextField
                _name: GeoStateCode
                value: GeocodeResult.StateCode
                label: "State Code"
                useCustomLabel: true
                dataType: STRING
              - _type: TextField
                _name: GeoPostalCode
                value: GeocodeResult.PostalCode
                label: "Postal Code"
                useCustomLabel: true
                dataType: STRING
              - _type: TextField
                _name: GeoCountryCode
                value: GeocodeResult.CountryCode
                label: "Country Code"
                useCustomLabel: true
                dataType: STRING
              - _type: TextField
                _name: GeoCountryName
                value: GeocodeResult.CountryName
                label: "Country Name"
                useCustomLabel: true
                dataType: STRING
              - _type: TextField
                _name: GeoLatitude
                value: GeocodeResult.Latitude
                label: "Latitude"
                useCustomLabel: true
                dataType: DECIMAL
              - _type: TextField
                _name: GeoLongitude
                value: GeocodeResult.Longitude
                label: "Longitude"
                useCustomLabel: true
                dataType: DECIMAL
              - _type: TextField
                _name: GeoAccessLatitude
                value: GeocodeResult.AccessLatitude
                label: "Access Latitude"
                useCustomLabel: true
                dataType: DECIMAL
              - _type: TextField
                _name: GeoAccessLongitude
                value: GeocodeResult.AccessLongitude
                label: "Access Longitude"
                useCustomLabel: true
                dataType: DECIMAL
              - _type: TextField
                _name: GeoMapViewWest
                value: GeocodeResult.MapViewWest
                label: "Map View West"
                useCustomLabel: true
                dataType: DECIMAL
              - _type: TextField
                _name: GeoMapViewSouth
                value: GeocodeResult.MapViewSouth
                label: "Map View South"
                useCustomLabel: true
                dataType: DECIMAL
              - _type: TextField
                _name: GeoMapViewEast
                value: GeocodeResult.MapViewEast
                label: "Map View East"
                useCustomLabel: true
                dataType: DECIMAL
              - _type: TextField
                _name: GeoMapViewNorth
                value: GeocodeResult.MapViewNorth
                label: "Map View North"
                useCustomLabel: true
                dataType: DECIMAL
              - _type: TextField
                _name: GeoQueryScore
                value: GeocodeResult.QueryScore
                label: "Query Score"
                useCustomLabel: true
                dataType: DECIMAL

          - _type: FormContainer
            _name: RightColumn
            layoutDirection: COLUMN
            relativeWidth: 33
            content:
            - _type: ObjectField
              _name: GoogleMaps
              dataType: STRING
              label: Google Maps View
              useCustomLabel: true
              visibleValue: "1"
              visibleValueInterpreter: LITERAL
              # visibleValue: case when enrichedAddress is null then "0" else "1" end
              # visibleValueInterpreter: SEMQL
              authoringMode: auto
              value: |
                    '<html>
                    <head>
                    <meta charset="utf-8">
                    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyB_Yyr4bb_JPuAM9gPp2GyXYCxUwl3vpkI&sensor=false"></script>
                    <script>
                    var address = "'||SEM_CONCAT(' ', HouseNumber, ' ', Street, ' ', City, ' ', PostalCode) ||'";
                    var zoom = 18;
                    var mapType = google.maps.MapTypeId.ROADMAP;
                    var useMarker = true;
                    var map;
                    function initialize() {
                        var geocoder = new google.maps.Geocoder();
                        geocoder.geocode({"address": address}, function(results, status){
                            if(status==google.maps.GeocoderStatus.OK){ displayMap(results[0].geometry.location); }
                        });
                        window.onresize = resize;
                    }
                    function displayMap(latlng){
                        var mapOptions = {zoom: zoom, center: latlng, mapTypeId: mapType};
                        map = new google.maps.Map(document.getElementById("map_canvas"), mapOptions);
                        if(useMarker){ var marker = new google.maps.Marker({map: map, position: latlng}); }
                        resize("");
                    }
                    function resize(e){
                        var center = map.getCenter();
                        map.getDiv().style.height = window.innerHeight + "px";
                        map.getDiv().style.width = window.innerWidth + "px";
                        google.maps.event.trigger(map, "resize");
                        map.setCenter(center);
                    }
                    google.maps.event.addDomListener(window, "load", initialize);
                    </script>
                    </head>
                    <body style="margin:0px;">
                    <div id="map_canvas" style="margin:0px;"></div>
                    </body>
                    </html>'
              componentProperties:
                sourceType: content
                textTypography: body-1
                objectHeight: "600"
              labelProperties:
                isVisible: '0'
                alignment: left
                position: left
                typography: caption