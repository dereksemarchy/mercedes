_package: CustomerMDM.entities.Address.forms
_type: Form
_name: AddressForm
entity: CustomerMDM.entities.Address.Address
default: true
formTabs:
  - _type: FormTab
    _name: Address
    label: Address
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    labelWidth: "150"
    content:
      - _type: FormContainer
        _name: MainRow
        layoutDirection: ROW
        content:
          - _type: FormSection
            _name: LeftColumn
            label: "Original Address"
            layoutDirection: COLUMN
            relativeWidth: 33
            content:
              - _type: IdField
                _name: AddressID
                value: AddressID
                useCustomLabel: false
                dataType: LONG_INTEGER
              - _type: TextField
                _name: HouseNumber
                value: HouseNumber
                useCustomLabel: false
                dataType: STRING
              - _type: TextField
                _name: Street
                value: Street
                useCustomLabel: false
                dataType: STRING
              - _type: TextField
                _name: City
                value: City
                useCustomLabel: false
                dataType: STRING
              - _type: TextField
                _name: PostalCode
                value: PostalCode
                useCustomLabel: false
                dataType: STRING
              - _type: ReferenceField
                _name: FDN_Country
                value: FDN_Country
                useCustomLabel: false
                dataType: STRING
                referencedEntity: CustomerMDM.entities.Country.Country
                componentProperties:
                  displayType: chip
                  useAvatarInChip: '1'
              - _type: MenuField
                _name: AddressUsage
                value: AddressUsage
                useCustomLabel: false
                dataType: STRING
              - _type: CheckboxField
                _name: Primary
                value: Primary
                useCustomLabel: false
                dataType: BOOLEAN
              - _type: CheckboxField
                _name: InCriticalUse
                value: InCriticalUse
                useCustomLabel: false
                dataType: BOOLEAN
              - _type: ReferenceField
                _name: FDN_AddressDefinition
                value: FDN_AddressDefinition
                useCustomLabel: false
                dataType: STRING
                referencedEntity: CustomerMDM.entities.AddressDefinition.AddressDefinition
              - _type: ReferenceField
                _name: FDN_IndividualContext
                value: FDN_IndividualContext
                useCustomLabel: false
                dataType: STRING
                referencedEntity: CustomerMDM.entities.IndividualContext.IndividualContext
          - _type: FormSection
            _name: HereGeocodeAddress
            layoutDirection: COLUMN
            relativeWidth: 33
            label: "HERE Geocode Address"
            labelWidth: "150px"
            content:
