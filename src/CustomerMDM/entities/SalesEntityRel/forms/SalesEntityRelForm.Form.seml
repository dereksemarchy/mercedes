_package: CustomerMDM.entities.SalesEntityRel.forms
_type: Form
_name: SalesEntityRelForm
entity: CustomerMDM.entities.SalesEntityRel.SalesEntityRel
default: true
formTabs:
  - _type: FormTab
    _name: SalesEntityRel
    label: Sales Entity Relationship
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    labelWidth: "150"
    content:
      - _type: IdField
        _name: SalesEntityRelID
        value: SalesEntityRelID
        useCustomLabel: false
        dataType: LONG_INTEGER
      - _type: ReferenceField
        _name: FDN_IndividualContext
        value: FDN_IndividualContext
        useCustomLabel: false
        dataType: STRING
        referencedEntity: CustomerMDM.entities.IndividualContext.IndividualContext
      - _type: ReferenceField
        _name: FDN_SalesEntity
        value: FDN_SalesEntity
        useCustomLabel: false
        dataType: STRING
        referencedEntity: CustomerMDM.entities.SalesEntity.SalesEntity
      - _type: MenuField
        _name: RelationshipType
        value: RelationshipType
        useCustomLabel: false
        dataType: STRING
      - _type: TextField
        _name: StartDate
        value: StartDate
        useCustomLabel: false
        dataType: DATE
      - _type: TextField
        _name: EndDate
        value: EndDate
        useCustomLabel: false
        dataType: DATE

