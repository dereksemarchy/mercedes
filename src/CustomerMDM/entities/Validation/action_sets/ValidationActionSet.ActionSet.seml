_package: CustomerMDM.entities.Validation.action_sets
_type: ActionSet
_name: ValidationActionSet
entity: CustomerMDM.entities.Validation.Validation
label: Validation Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorValidations
    label: Create
    useCustomLabel: true
    stepper: CustomerMDM.entities.Validation.steppers.AuthorValidations
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorValidations
    label: Edit
    useCustomLabel: true
    stepper: CustomerMDM.entities.Validation.steppers.AuthorValidations
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorValidations
    label: Mass Update
    useCustomLabel: true
    stepper: CustomerMDM.entities.Validation.steppers.AuthorValidations
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorValidations
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: CustomerMDM.entities.Validation.steppers.AuthorValidations
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
