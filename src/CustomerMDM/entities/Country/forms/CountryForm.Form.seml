_package: CustomerMDM.entities.Country.forms
_type: Form
_name: CountryForm
entity: CustomerMDM.entities.Country.Country
default: true
formTabs:
  - _type: FormTab
    _name: Country
    label: Country
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    labelWidth: "150"
    content:
      - _type: IdField
        _name: CountryCode
        value: CountryCode
        useCustomLabel: false
        dataType: STRING
      - _type: TextField
        _name: CountryName
        value: CountryName
        useCustomLabel: false
        dataType: STRING
      - _type: MenuField
        _name: Region
        value: Region
        useCustomLabel: false
        dataType: STRING
      - _type: CheckboxField
        _name: Active
        value: Active
        useCustomLabel: false
        dataType: BOOLEAN
      - _type: TextField
        _name: DefaultLanguage
        value: LOOKUP first Language from CountryLanguage where IsDefault = '1' end
        useCustomLabel: true
        label: Default Language
        dataType: STRING