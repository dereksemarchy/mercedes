_package: CustomerMDM.entities.SalesEntity.action_sets
_type: ActionSet
_name: SalesEntityActionSet
entity: CustomerMDM.entities.SalesEntity.SalesEntity
label: Sales Entity Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorSalesEntities
    label: Create
    useCustomLabel: true
    stepper: CustomerMDM.entities.SalesEntity.steppers.AuthorSalesEntities
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorSalesEntities
    label: Edit
    useCustomLabel: true
    stepper: CustomerMDM.entities.SalesEntity.steppers.AuthorSalesEntities
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorSalesEntities
    label: Mass Update
    useCustomLabel: true
    stepper: CustomerMDM.entities.SalesEntity.steppers.AuthorSalesEntities
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorSalesEntities
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: CustomerMDM.entities.SalesEntity.steppers.AuthorSalesEntities
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
