_package: CustomerMDM.entities.Phone.forms
_type: Form
_name: PhoneForm
entity: CustomerMDM.entities.Phone.Phone
default: true
formTabs:
  - _type: FormTab
    _name: Phone
    label: Phone
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    labelWidth: "150"
    content:
      - _type: IdField
        _name: PhoneID
        value: PhoneID
        useCustomLabel: false
        dataType: LONG_INTEGER
      - _type: TextField
        _name: PhoneNumber
        value: PhoneNumber
        useCustomLabel: false
        dataType: STRING
      - _type: CheckboxField
        _name: Primary
        value: Primary
        useCustomLabel: false
        dataType: BOOLEAN
      - _type: CheckboxField
        _name: InCriticalUse
        value: InCriticalUse
        useCustomLabel: false
        dataType: BOOLEAN
      - _type: MenuField
        _name: PhoneUsage
        value: PhoneUsage
        useCustomLabel: false
        dataType: STRING
      - _type: ReferenceField
        _name: FDN_IndividualContext
        value: FDN_IndividualContext
        useCustomLabel: false
        dataType: STRING
        referencedEntity: CustomerMDM.entities.IndividualContext.IndividualContext
