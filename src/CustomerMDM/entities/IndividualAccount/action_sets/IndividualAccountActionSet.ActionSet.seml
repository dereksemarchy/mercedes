_package: CustomerMDM.entities.IndividualAccount.action_sets
_type: ActionSet
_name: IndividualAccountActionSet
entity: CustomerMDM.entities.IndividualAccount.IndividualAccount
label: Individual Account Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorIndividualAccounts
    label: Create
    useCustomLabel: true
    stepper: CustomerMDM.entities.IndividualAccount.steppers.AuthorIndividualAccounts
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorIndividualAccounts
    label: Edit
    useCustomLabel: true
    stepper: CustomerMDM.entities.IndividualAccount.steppers.AuthorIndividualAccounts
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorIndividualAccounts
    label: Mass Update
    useCustomLabel: true
    stepper: CustomerMDM.entities.IndividualAccount.steppers.AuthorIndividualAccounts
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorIndividualAccounts
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: CustomerMDM.entities.IndividualAccount.steppers.AuthorIndividualAccounts
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
