_package: CustomerMDM.entities.AddressDefinition.forms
_type: Form
_name: AddressDefinitionForm
entity: CustomerMDM.entities.AddressDefinition.AddressDefinition
default: true
formTabs:
  - _type: FormTab
    _name: AddressDefinition
    label: Address Definition
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    labelWidth: "150"
    content:
      - _type: IdField
        _name: AddressDefinitionID
        value: AddressDefinitionID
        useCustomLabel: false
        dataType: LONG_INTEGER
      - _type: MenuField
        _name: AddressDefinitionCode
        value: AddressDefinitionCode
        useCustomLabel: false
        dataType: STRING
      - _type: CheckboxField
        _name: IsDefault
        value: IsDefault
        useCustomLabel: false
        dataType: BOOLEAN
      - _type: CheckboxField
        _name: Active
        value: Active
        useCustomLabel: false
        dataType: BOOLEAN
      - _type: ReferenceField
        _name: FDN_Country
        value: FDN_Country
        useCustomLabel: false
        dataType: STRING
        referencedEntity: CustomerMDM.entities.Country.Country
