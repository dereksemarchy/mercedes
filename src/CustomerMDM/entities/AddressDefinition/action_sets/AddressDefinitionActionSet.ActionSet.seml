_package: CustomerMDM.entities.AddressDefinition.action_sets
_type: ActionSet
_name: AddressDefinitionActionSet
entity: CustomerMDM.entities.AddressDefinition.AddressDefinition
label: Address Definition Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorAddressDefinitions
    label: Create
    useCustomLabel: true
    stepper: CustomerMDM.entities.AddressDefinition.steppers.AuthorAddressDefinitions
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorAddressDefinitions
    label: Edit
    useCustomLabel: true
    stepper: CustomerMDM.entities.AddressDefinition.steppers.AuthorAddressDefinitions
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorAddressDefinitions
    label: Mass Update
    useCustomLabel: true
    stepper: CustomerMDM.entities.AddressDefinition.steppers.AuthorAddressDefinitions
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorAddressDefinitions
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: CustomerMDM.entities.AddressDefinition.steppers.AuthorAddressDefinitions
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
