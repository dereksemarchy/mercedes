_package: CustomerMDM.entities.Company
_type: Entity
_name: Company
label: Company
pluralLabel: Company
physicalTableName: COMPANY
iconUrl: images://mdi/domain.svg
description: ""
documentation: ""
historizeGolden: false
historizeMaster: false
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: CompanyID
    label: Company ID
    physicalName: COMPANY_ID
    dataType: LongInteger
    precision: 38
    mandatory: true
    searchable: true
  - _type: EntityAttribute
    _name: CompanyMEID
    label: Company ME ID
    physicalName: COMPANY_ME_ID
    dataType: String
    mandatory: true
    searchable: true
    length: 128
    mandatoryValidationScope: PRE_CONSO
  - _type: EntityAttribute
    _name: FullName
    label: Full Name
    physicalName: FULL_NAME
    dataType: String
    mandatory: true
    searchable: true
    length: 256
    mandatoryValidationScope: PRE_CONSO
  - _type: EntityAttribute
    _name: ShortName
    label: Short Name
    physicalName: SHORT_NAME
    dataType: String
    mandatory: true
    searchable: true
    length: 128
    mandatoryValidationScope: PRE_CONSO
  - _type: EntityAttribute
    _name: FullNameLocal
    label: Full Name (Local)
    physicalName: FULL_NAME_LOCAL
    dataType: String
    mandatory: false
    searchable: true
    length: 256
    mandatoryValidationScope: PRE_CONSO
  - _type: EntityAttribute
    _name: ShortNameLocal
    label: Short Name (Local)
    physicalName: SHORT_NAME_LOCAL
    dataType: String
    mandatory: false
    searchable: true
    length: 128
    mandatoryValidationScope: PRE_CONSO
  - _type: EntityAttribute
    _name: LegalForm
    label: Legal Form
    physicalName: LEGAL_FORM
    dataType: CustomerMDM.list_of_values.LegalForm
    mandatory: false
    searchable: true
    length: 16
    mandatoryValidationScope: PRE_CONSO
    lovValidationScope: PRE_CONSO
sourceIdGeneration:
  mode: UUID
  # startWith: 1
primaryKey: CustomerMDM.entities.Company.Company.CompanyID
entityType: FUZZY_MATCHED
goldenIdGeneration:
  mode: SEQUENCE
  startWith: 1
matcher:
  _type: SemQLMatcher
  _name: Matcher
  description: CompanySemQLMatcher
  matchRules:
    - _type: SemQLMatchRule
      _name: ExactFullName
      label: Exact Full Name
      condition: Record1.FullName = Record2.FullName
      matchScore: 100
      usingMatchOn: false
  useTransitiveMatchScore: true
  useMultiIterationGrouping: true
  mergeThresholdNewGroup: 75
  mergeThresholdMergingUnconfirmed: 75
  mergeThresholdMergingConfirmed: 75
  mergeThresholdMergingConfirmedWithUnconfirmed: 75
  mergeThresholdMergingUnconfirmedWithNewMasters: 75
  mergeThresholdMergingConfirmedWithNewMasters: 75
  mergeThresholdRemergingPreviouslySplit: 100
  autoConfirmGoldenThreshold: 99
  autoConfirmSingletons: false
