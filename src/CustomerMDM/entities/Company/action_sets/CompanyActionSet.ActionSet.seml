_package: CustomerMDM.entities.Company.action_sets
_type: ActionSet
_name: CompanyActionSet
entity: CustomerMDM.entities.Company.Company
label: Company Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorCompanies
    label: Create
    useCustomLabel: true
    stepper: CustomerMDM.entities.Company.steppers.AuthorCompanies
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorCompanies
    label: Edit
    useCustomLabel: true
    stepper: CustomerMDM.entities.Company.steppers.AuthorCompanies
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorCompanies
    label: Mass Update
    useCustomLabel: true
    stepper: CustomerMDM.entities.Company.steppers.AuthorCompanies
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorCompanies
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: CustomerMDM.entities.Company.steppers.AuthorCompanies
    importedRecordType: MASTER
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: CopyAction
    _name: CopyAuthorCompanies
    label: Copy
    useCustomLabel: true
    stepper: CustomerMDM.entities.Company.steppers.AuthorCompanies
    multipleSelectionAllowed: true
    waitDialogEnabled: false
  - _type: DirectConfirmDupsAction
    _name: DirectConfirmDuplicates
    label: Direct Confirm Duplicates
    useCustomLabel: false
    waitDialogEnabled: false
  - _type: ReviewAndConfirm
    _name: ReviewAndConfirmDuplicatesManageDuplicatesOnCompany
    label: Review and Confirm Duplicates
    useCustomLabel: true
    dupsManager: CustomerMDM.entities.Company.dups_managers.ManageDuplicatesOnCompany
    enableEdit: true
    mandateConfirmAll: false
    waitDialogEnabled: false
  - _type: MergeOrSplit
    _name: MergeOrSplitDuplicatesManageDuplicatesOnCompany
    label: Merge Or Split Duplicates
    useCustomLabel: true
    dupsManager: CustomerMDM.entities.Company.dups_managers.ManageDuplicatesOnCompany
    enableEdit: true
    waitDialogEnabled: false
  - _type: ReviewSuggestions
    _name: ReviewSuggestionsDuplicatesManageDuplicatesOnCompany
    label: Review Duplicates Suggestions
    useCustomLabel: true
    dupsManager: CustomerMDM.entities.Company.dups_managers.ManageDuplicatesOnCompany
    enableEdit: true
    waitDialogEnabled: false
    onAcceptPromptGoldenId: false
    mandateResolveAllSuggestions: false
  - _type: ExplainRecordAction
    _name: ExplainRecord
    label: Explain Record
    useCustomLabel: true
    displayCard: CustomerMDM.entities.Company.display_cards.CompanyDisplayCard
    formTab: CustomerMDM.entities.Company.forms.CompanyForm.Company
    waitDialogEnabled: false
