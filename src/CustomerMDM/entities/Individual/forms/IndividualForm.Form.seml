_package: CustomerMDM.entities.Individual.forms
_type: Form
_name: IndividualForm
entity: CustomerMDM.entities.Individual.Individual
default: true
formTabs:
  - _type: FormTab
    _name: Individual
    label: Individual
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    labelWidth: "150"
    content:
      - _type: FormContainer
        _name: Main
        layoutDirection: ROW
        content:
          - _type: FormContainer
            _name: IndividualDetails
            layoutDirection: COLUMN
            content:
              - _type: IdField
                _name: IndividualID
                value: IndividualID
                useCustomLabel: false
                dataType: LONG_INTEGER
              - _type: MenuField
                _name: Gender
                value: Gender
                useCustomLabel: false
                dataType: STRING
              - _type: MenuField
                _name: Salutation
                value: Salutation
                useCustomLabel: false
                dataType: STRING
              - _type: TextField
                _name: FirstName
                value: FirstName
                useCustomLabel: false
                dataType: STRING
              - _type: TextField
                _name: LastName
                value: LastName
                useCustomLabel: false
                dataType: STRING
              - _type: TextField
                _name: NormalizedFirstName
                value: NormalizedFirstName
                useCustomLabel: false
                dataType: STRING
              - _type: TextField
                _name: NormalizedLastName
                value: NormalizedLastName
                useCustomLabel: false
                dataType: STRING
              - _type: TextField
                _name: PhoneticFirstName
                value: PhoneticFirstName
                useCustomLabel: false
                dataType: STRING
              - _type: TextField
                _name: PhoneticLastName
                value: PhoneticLastName
                useCustomLabel: false
                dataType: STRING
              - _type: TextField
                _name: NickName
                value: NickName
                useCustomLabel: false
                dataType: STRING
              - _type: TextField
                _name: Birthday
                value: Birthday
                useCustomLabel: false
                dataType: DATE
              - _type: TextField
                _name: NameComponents
                value: NameComponents
                useCustomLabel: false
                dataType: STRING
          - _type: FormContainer
            _name: IndividualKeysDetails
            layoutDirection: COLUMN
            content:
              - _type: TextField
                _name: UsGcids
                value: UsGcids
                useCustomLabel: false
                dataType: STRING
              - _type: TextField
                _name: PrimaryUsGcid
                value: PrimaryUsGcid
                useCustomLabel: false
                dataType: STRING
              - _type: TextField
                _name: EmailKeys
                value: EmailKeys
                useCustomLabel: false
                dataType: STRING
              - _type: TextField
                _name: PhoneKeys
                value: PhoneKeys
                useCustomLabel: false
                dataType: STRING
              # - _type: TextField
              #   _name: Test
              #   value: keys_overlap('A|B', 'B|C')
              #   useCustomLabel: false
              #   dataType: STRING
              # - _type: TextField
              #   _name: Test2
              #   value: keys_overlap('A|B', 'C|D')
              #   useCustomLabel: false
              #   dataType: STRING