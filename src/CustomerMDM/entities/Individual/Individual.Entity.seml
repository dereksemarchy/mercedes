_package: CustomerMDM.entities.Individual
_type: Entity
_name: Individual
label: Individual
pluralLabel: Individual
physicalTableName: INDIVIDUAL
iconUrl: images://mdi/account-outline.svg
description: ""
documentation: ""
historizeGolden: true
historizeMaster: true
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: IndividualID
    label: Individual ID
    physicalName: INDIVIDUAL_ID
    dataType: LongInteger
    precision: 38
    mandatory: true
    searchable: true
  - _type: EntityAttribute
    _name: Gender
    label: Gender
    physicalName: GENDER
    dataType: CustomerMDM.list_of_values.Gender
    mandatory: false
    searchable: true
    lovValidationScope: PRE_CONSO
  - _type: EntityAttribute
    _name: Salutation
    label: Salutation
    physicalName: SALUTATION
    dataType: CustomerMDM.list_of_values.Salutation
    mandatory: false
    searchable: true
    lovValidationScope: PRE_CONSO
  - _type: EntityAttribute
    _name: FirstName
    label: First Name
    physicalName: FIRST_NAME
    dataType: String
    mandatory: true
    searchable: true
    length: 128
    mandatoryValidationScope: PRE_CONSO
  - _type: EntityAttribute
    _name: LastName
    label: Last Name
    physicalName: LAST_NAME
    dataType: String
    mandatory: true
    searchable: true
    length: 128
    mandatoryValidationScope: PRE_CONSO
  - _type: EntityAttribute
    _name: NickName
    label: Nick Name
    physicalName: NICK_NAME
    dataType: String
    mandatory: false
    searchable: true
    length: 128
  - _type: EntityAttribute
    _name: Birthday
    label: Birthday
    physicalName: BIRTHDAY
    dataType: Date
    mandatory: false
    searchable: true
  - _type: EntityAttribute
    _name: NameComponents
    label: Name Components
    physicalName: NAME_COMPONENTS
    dataType: String
    mandatory: false
    searchable: true
    length: 256
  - _type: EntityAttribute
    _name: NormalizedFirstName
    label: Normalized First Name
    physicalName: NORMALIZED_FIRST_NAME
    dataType: String
    mandatory: false
    searchable: true
    length: 128
  - _type: EntityAttribute
    _name: NormalizedLastName
    label: Normalized Last Name
    physicalName: NORMALIZED_LAST_NAME
    dataType: String
    mandatory: false
    searchable: true
    length: 128
  - _type: EntityAttribute
    _name: PhoneticFirstName
    label: Phonetic First Name
    physicalName: PHONETIC_FIRST_NAME
    dataType: String
    mandatory: false
    searchable: true
    length: 128
  - _type: EntityAttribute
    _name: PhoneticLastName
    label: Phonetic Last Name
    physicalName: PHONETIC_LAST_NAME
    dataType: String
    mandatory: false
    searchable: true
    length: 128
  - _type: EntityAttribute
    _name: UsGcids
    label: US GC IDs
    description: GC IDs of the US sales entities linked to the individual through its contexts, separated by |. Computed before matching from the previous load.
    physicalName: US_GCIDS
    dataType: String
    length: 400
    searchable: false
    mandatory: false
  - _type: EntityAttribute
    _name: EmailKeys
    label: Email keys
    description: Cleansed email addresses of the individual's contexts, separated by |. Computed before matching from the previous load.
    physicalName: EMAIL_KEYS
    dataType: String
    length: 2000
    searchable: false
    mandatory: false
  - _type: EntityAttribute
    _name: PhoneKeys
    label: Phone keys
    description: Standardized phone numbers of the individual's contexts, separated by |. Computed before matching from the previous load.
    physicalName: PHONE_KEYS
    dataType: String
    length: 1000
    searchable: false
    mandatory: false
  # - _type: EntityAttribute
  #   _name: PrimaryUsGcid
  #   label: Primary US GC ID
  #   description: 'First US GC ID of the individual, the matching bin: only individuals of the same US sales entity are compared. AI agent instructions: technical attribute, do not display.'
  #   physicalName: PRIMARY_US_GCID
  #   dataType: String
  #   length: 20
  #   searchable: false
  #   goldenAttribute: false
  #   mandatory: false
sourceIdGeneration:
  mode: MANUAL
primaryKey: CustomerMDM.entities.Individual.Individual.IndividualID
entityType: FUZZY_MATCHED
goldenIdGeneration:
  mode: SEQUENCE
  startWith: 1
matcher:
  _type: SemQLMatcher
  _name: Matcher
  description: IndividualSemQLMatcher
  matchRules:
    - _type: SemQLMatchRule
      _name: SameNameBirthdayAndEmailAddress
      label: Same Name, Birthday And Email Address
      condition: Record1.Email.EmailAddress = Record2.Email.EmailAddress
        # AND NOT any Record1.IndividualContext.SalesEntityRel have (
        #   SalesEntity.Country.CountryCode = 'US'
        # )
        # AND NOT any Record2.IndividualContext.SalesEntityRel have (
        #   SalesEntity.Country.CountryCode = 'US'
        # )
      matchScore: 100
      usingMatchOn: true
      matchOnExpression: IndividualContext.EmailIndividualContext
      binningExpressions:
        - expression: IndividualContext.Individual.FirstName
        - expression: IndividualContext.Individual.LastName
        - expression: IndividualContext.Individual.Birthday
    # - _type: SemQLMatchRule
    #   _name: ExactNameAndBirthday
    #   label: Exact Name And Birthday
    #   condition: Record1.FirstName = Record2.FirstName AND Record1.LastName = Record2.LastName AND Record1.Birthday = Record2.Birthday
    #   matchScore: 99
    #   usingMatchOn: false
    # - _type: SemQLMatchRule
    #   _name: ExactNameAndBirthdayForUS
    #   label: Exact Name And Birthday For US
    #   condition: |-
    #     Record1.FirstName = Record2.FirstName
    #     AND Record1.LastName = Record2.LastName
    #     AND Record1.Birthday = Record2.Birthday
    #     AND any Record1.IndividualContext.SalesEntityRel have (
    #       SalesEntity.Country.CountryCode = 'US'
    #       AND any ParentRecord.Record2.IndividualContext.SalesEntityRel have (
    #         SalesEntity.GCID = ParentRecord.SalesEntity.GCID
    #       )
    #     )
    #   matchScore: 99
    #   usingMatchOn: true
    # - _type: SemQLMatchRule
    #   _name: ExactNameAndBirthdayForUS
    #   label: Exact Name And Birthday For US
    #   matchScore: 99
    #   usingMatchOn: true
    #   condition: Record1.SalesEntity.GCID = Record2.SalesEntity.GCID
    #     AND Record1.SalesEntity.Country.CountryCode = 'US'
    #     AND Record2.SalesEntity.Country.CountryCode = 'US'
    #   matchOnExpression: IndividualContext.SalesEntityRel
    #   binningExpressions:
    #     - expression: IndividualContext.Individual.FirstName
    #     - expression: IndividualContext.Individual.LastName
    #     - expression: IndividualContext.Individual.Birthday
    # - _type: SemQLMatchRule
    #   _name: SimilarNameAndSameBirthday
    #   label: Similar Name And Same Birthday
    #   condition: ( SEM_EDIT_DISTANCE_SIMILARITY( Record1.FirstName, Record2.FirstName ) > 75 AND SEM_EDIT_DISTANCE_SIMILARITY(Record1.LastName, Record2.LastName ) > 75 ) AND Record1.Birthday = Record2.Birthday
    #   matchScore: 70
    #   usingMatchOn: false
    - _type: SemQLMatchRule
      _name: UsExactIdentity
      label: US exact identity
      description: Shares at least one US sales entity (GC ID), same birthday, normalized first and last name, and at least one shared email or phone key. Merges and confirms.
      matchScore: 100
      binningExpressions:
      - expression: Birthday
      - expression: FirstName
      - expression: LastName
      condition: keys_overlap(Record1.UsGcids, Record2.UsGcids) = 1
        AND (
          keys_overlap(Record1.EmailKeys, Record2.EmailKeys) = 1
          OR keys_overlap(Record1.PhoneKeys, Record2.PhoneKeys) = 1
        )
    - _type: SemQLMatchRule
      _name: SamePhoneticNameAndSameBirthday
      label: Same Phonetic Name And Same Birthday
      condition: Record1.PhoneticFirstName = Record2.PhoneticFirstName AND Record1.PhoneticLastName = Record2.PhoneticLastName AND Record1.Birthday = Record2.Birthday
      matchScore: 60
      usingMatchOn: false
  useTransitiveMatchScore: true
  useMultiIterationGrouping: true
  mergeThresholdNewGroup: 75
  mergeThresholdMergingUnconfirmed: 75
  mergeThresholdMergingConfirmed: 75
  mergeThresholdMergingConfirmedWithUnconfirmed: 75
  mergeThresholdMergingUnconfirmedWithNewMasters: 75
  mergeThresholdMergingConfirmedWithNewMasters: 75
  mergeThresholdRemergingPreviouslySplit: 100
  autoConfirmGoldenThreshold: 99
  autoConfirmSingletons: false
