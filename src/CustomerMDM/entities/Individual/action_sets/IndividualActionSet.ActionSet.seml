_package: CustomerMDM.entities.Individual.action_sets
_type: ActionSet
_name: IndividualActionSet
entity: CustomerMDM.entities.Individual.Individual
label: Individual Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorIndividuals
    label: Create
    useCustomLabel: true
    stepper: CustomerMDM.entities.Individual.steppers.AuthorIndividuals
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorIndividuals
    label: Edit
    useCustomLabel: true
    stepper: CustomerMDM.entities.Individual.steppers.AuthorIndividuals
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: true
    availableForErrorData: true
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorIndividuals
    label: Mass Update
    useCustomLabel: true
    stepper: CustomerMDM.entities.Individual.steppers.AuthorIndividuals
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorIndividuals
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: CustomerMDM.entities.Individual.steppers.AuthorIndividuals
    importedRecordType: MASTER
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: DirectConfirmDupsAction
    _name: DirectConfirmDuplicates
    label: Direct Confirm Duplicates
    useCustomLabel: false
    waitDialogEnabled: false
  - _type: ReviewAndConfirm
    _name: ReviewAndConfirmDuplicatesManageDuplicatesOnIndividual
    label: Review and Confirm Duplicates
    useCustomLabel: true
    dupsManager: CustomerMDM.entities.Individual.dups_managers.ManageDuplicatesOnIndividual
    enableEdit: true
    mandateConfirmAll: false
    waitDialogEnabled: false
  - _type: MergeOrSplit
    _name: MergeOrSplitDuplicatesManageDuplicatesOnIndividual
    label: Merge Or Split Duplicates
    useCustomLabel: true
    dupsManager: CustomerMDM.entities.Individual.dups_managers.ManageDuplicatesOnIndividual
    enableEdit: true
    waitDialogEnabled: false
  - _type: ReviewSuggestions
    _name: ReviewSuggestionsDuplicatesManageDuplicatesOnIndividual
    label: Review Duplicates Suggestions
    useCustomLabel: true
    dupsManager: CustomerMDM.entities.Individual.dups_managers.ManageDuplicatesOnIndividual
    enableEdit: true
    waitDialogEnabled: false
    onAcceptPromptGoldenId: false
    mandateResolveAllSuggestions: false
  - _type: ExplainRecordAction
    _name: ExplainRecord
    label: Explain Record
    useCustomLabel: true
    displayCard: CustomerMDM.entities.Individual.display_cards.IndividualDisplayCard
    formTab: CustomerMDM.entities.Individual.forms.IndividualForm.Individual
    waitDialogEnabled: false
