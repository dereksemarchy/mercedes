_package: CustomerMDM.entities.Individual.display_cards
_type: DisplayCard
_name: IndividualDisplayCard
entity: CustomerMDM.entities.Individual.Individual
default: true
primaryTextExpression: FirstName||' '||LastName
primaryImageValueInterpreter: LITERAL
avatarImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: SEMQL
primaryImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
avatarImageValue: CASE WHEN Gender = 'MALE' THEN 'images://mdi/human-male.svg' ELSE 'images://mdi/human-female.svg' END
