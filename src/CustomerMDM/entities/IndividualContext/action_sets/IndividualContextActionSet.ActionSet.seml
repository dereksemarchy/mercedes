_package: CustomerMDM.entities.IndividualContext.action_sets
_type: ActionSet
_name: IndividualContextActionSet
entity: CustomerMDM.entities.IndividualContext.IndividualContext
label: Individual Context Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorIndividualContexts
    label: Create
    useCustomLabel: true
    stepper: CustomerMDM.entities.IndividualContext.steppers.AuthorIndividualContexts
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorIndividualContexts
    label: Edit
    useCustomLabel: true
    stepper: CustomerMDM.entities.IndividualContext.steppers.AuthorIndividualContexts
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorIndividualContexts
    label: Mass Update
    useCustomLabel: true
    stepper: CustomerMDM.entities.IndividualContext.steppers.AuthorIndividualContexts
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorIndividualContexts
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: CustomerMDM.entities.IndividualContext.steppers.AuthorIndividualContexts
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
