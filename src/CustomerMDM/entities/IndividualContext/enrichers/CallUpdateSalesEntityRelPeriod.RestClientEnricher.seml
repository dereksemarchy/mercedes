_name: CallUpdateSalesEntityRelPeriod
_type: RestClientEnricher
_package: CustomerMDM.entities.IndividualContext.enrichers
entity: CustomerMDM.entities.IndividualContext.IndividualContext
label: Call Update Sales Entity Rel Period
description: >
  Calls the UpdateSalesEntityRelPeriod REST client to mass-update the
  SalesEntityRel records for this IndividualContext / SalesEntity pair and
  run SetRelationshipPeriodToToday.
enricherExecutionScope: NONE
condition: IndividualContextID is not null and GCID is not null
pluginId: UpdateSalesEntityRelPeriod
pluginInputs:
  - inputName: UpdateCondition
    expression: >-
      'FID_IndividualContext = ''' || IndividualContextID ||
      ''' and FID_SalesEntity = ''' || GCID || ''''
pluginOutputs:
  - outputName: status
    attributeName: SyncStatus
numberOfRetry: 0
onErrorBehavior: SKIP_RECORDS
processingBatchSize: 1
threadPoolSize: 1