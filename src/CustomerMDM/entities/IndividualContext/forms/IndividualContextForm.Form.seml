_package: CustomerMDM.entities.IndividualContext.forms
_type: Form
_name: IndividualContextForm
entity: CustomerMDM.entities.IndividualContext.IndividualContext
default: true
formTabs:
  - _type: FormTab
    _name: IndividualContext
    label: Individual Context
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    labelWidth: "150"
    content:
      - _type: IdField
        _name: IndividualContextID
        value: IndividualContextID
        useCustomLabel: false
        dataType: STRING
      - _type: MenuField
        _name: ContextType
        value: ContextType
        useCustomLabel: false
        dataType: STRING
      - _type: MenuField
        _name: BusinessRole
        value: BusinessRole
        useCustomLabel: false
        dataType: STRING
      - _type: DateField
        _name: StartDate
        value: StartDate
        useCustomLabel: false
        dataType: DATE
      - _type: DateField
        _name: EndDate
        value: EndDate
        useCustomLabel: false
        dataType: DATE
      - _type: ReferenceField
        _name: FDN_Individual
        value: FDN_Individual
        useCustomLabel: false
        dataType: STRING
        referencedEntity: CustomerMDM.entities.Individual.Individual
      - _type: ReferenceField
        _name: FDN_Company
        value: FDN_Company
        useCustomLabel: false
        dataType: STRING
        referencedEntity: CustomerMDM.entities.Company.Company
