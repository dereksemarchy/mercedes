    maxResults: 100
    viewType: "GD"
    searchTypeConfig: CustomerMDM.entities.Individual.business_views.IndividualReviewSuggestionBusinessView.Individual.TextConfig
  - _type: GlobalSearchBoView
    _name: Address
    label: Address
    businessView: CustomerMDM.entities.Address.business_views.AddressBusinessView
    maxResults: 100
    viewType: "GD"
    searchTypeConfig: CustomerMDM.entities.Address.business_views.AddressBusinessView.Address.TextConfig
  - _type: GlobalSearchBoView
    _name: AddressDefinition
    label: Address Definition
    businessView: CustomerMDM.entities.AddressDefinition.business_views.AddressDefinitionBusinessView
    maxResults: 100
    viewType: "GD"
    searchTypeConfig: CustomerMDM.entities.AddressDefinition.business_views.AddressDefinitionBusinessView.AddressDefinition.TextConfig
  - _type: GlobalSearchBoView
    _name: Country
    label: Country
    businessView: CustomerMDM.entities.Country.business_views.CountryBusinessView
    maxResults: 100
    viewType: "GD"
    searchTypeConfig: CustomerMDM.entities.Country.business_views.CountryBusinessView.Country.TextConfig
  - _type: GlobalSearchBoView
    _name: CountryLanguage
    label: Country Language
    businessView: CustomerMDM.entities.CountryLanguage.business_views.CountryLanguageBusinessView
    maxResults: 100
    viewType: "GD"
    searchTypeConfig: CustomerMDM.entities.CountryLanguage.business_views.CountryLanguageBusinessView.CountryLanguage.TextConfig
  - _type: GlobalSearchBoView
    _name: Email
    label: Email
    businessView: CustomerMDM.entities.Email.business_views.EmailBusinessView
    maxResults: 100
    viewType: "GD"
    searchTypeConfig: CustomerMDM.entities.Email.business_views.EmailBusinessView.Email.TextConfig
  - _type: GlobalSearchBoView
    _name: EmailIndividualContext
    label: Email Individual Context
    businessView: CustomerMDM.entities.EmailIndividualContext.business_views.EmailIndividualContextBusinessView
    maxResults: 100
    viewType: "GD"
    searchTypeConfig: CustomerMDM.entities.EmailIndividualContext.business_views.EmailIndividualContextBusinessView.EmailIndividualContext.TextConfig
