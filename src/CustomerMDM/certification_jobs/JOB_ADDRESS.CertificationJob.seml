_name: JOB_ADDRESS
_type: CertificationJob
_package: CustomerMDM.certification_jobs
jobType: INTEGRATION
queueName: Default
modelTasks:
  - _type: ModelJobTask
    entity: CustomerMDM.entities.Address.Address
    _name: Address
    consolidatedDataEnrichmentEnabled: true
    consolidationEnabled: true
    postConsoValidationEnabled: true
    sourceDataEnrichmentEnabled: true
    sourceValidationEnabled: true
jobParams:
  - _name: PARAM_ANALYZE_STATS
    _type: ModelJobParam
    value: "0"          # 0 = skip statistics collection, 1 = collect (default)
  - _name: PARAM_ENABLE_DELETE_PHASE
    _type: ModelJobParam
    value: "0"          # 0 = disable delete phase, 1 = enable delete phase (default)